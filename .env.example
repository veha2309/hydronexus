# Private scientific service. Never prefix these values with NEXT_PUBLIC_.
HYDRONEXUS_DATA_API_URL=http://127.0.0.1:8000
HYDRONEXUS_SERVICE_TOKEN=replace-with-a-long-random-service-token
# Local artifact root for immutable raw and QC products. Use S3 in production.
HYDRONEXUS_DATA_DIR=.hydronexus-data

# Generate with: npm run research:hash-password
HYDRONEXUS_RESEARCH_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$replace$replace
HYDRONEXUS_SESSION_SECRET=replace-with-at-least-32-random-characters
HYDRONEXUS_RESEARCH_AUTH_VERSION=1
# Local development only. This is ignored by production builds.
HYDRONEXUS_RESEARCH_AUTH_BYPASS=false

# Required in production for shared login rate limiting.
HYDRONEXUS_REDIS_URL=redis://127.0.0.1:6379

# Optional canonical public URL used by sitemap generation.
HYDRONEXUS_PUBLIC_URL=http://127.0.0.1:3000
